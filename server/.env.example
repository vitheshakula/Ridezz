# Copy to .env and fill in. Never commit real values.

# ---- Required -------------------------------------------------------------------------------
# Signs login tokens. At least 32 characters; the server refuses to start without it.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_at_least_32_random_characters
# PostgreSQL connection URL used by Prisma. Include the SSL parameters required by your provider.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# LiveKit server credentials and WebSocket URL. LIVEKIT_URL must use ws:// or wss://.
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_URL=wss://your-project.livekit.cloud

# ---- Server (optional) -----------------------------------------------------------------------
# Defaults to 5000 when omitted.
PORT=5000

# ---- Private testing (optional) --------------------------------------------------------------
# Only these addresses can register or sign in; everyone else gets "private testing" (403), and
# tokens already issued to anyone else stop working. Separate with commas, spaces or new lines.
# Leave empty for no restriction (any Gmail account). Google Cloud's "test users" list is NOT a
# substitute: Google enforces it, the server never sees it, and it doesn't reliably stop sign-in.
ALLOWED_EMAILS=

# ---- Google sign-in (optional: without the client id the app's "Continue with Google" is off) --
# OAuth client ID of type "Web application" (Google Cloud Console > APIs & Services > Credentials).
# The mobile app fetches this from the server, so it lives here only.
GOOGLE_CLIENT_ID=your_google_client_id
