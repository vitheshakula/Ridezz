generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  riderName String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  rooms     Room[]
}

model Room {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  hostId    String
  host      User     @relation(fields: [hostId], references: [id])
  createdAt DateTime @default(now())
}