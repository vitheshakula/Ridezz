{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "description": "Ridezz backend: accounts, ride rooms and LiveKit token issuance.",
  "license": "UNLICENSED",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.mjs\" \"*.{js,mjs}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.mjs\" \"*.{js,mjs}\"",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --import tsx --test \"src/**/*.test.ts\"",
    "test:integration": "node --import tsx --test --test-concurrency=1 \"test/integration/**/*.test.ts\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "node scripts/migrate-deploy.mjs",
    "test:coverage": "node --import tsx --test --experimental-test-coverage --test-coverage-exclude=\"src/**/*.test.ts\" --test-coverage-lines=85 --test-coverage-branches=85 --test-coverage-functions=85 \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@sentry/node": "11.10.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "5.2.1",
    "express-rate-limit": "^8.7.0",
    "google-auth-library": "^11.1.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "livekit-server-sdk": "^2.18.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "rate-limit-redis": "6.0.2",
    "redis": "6.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.43",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "eslint": "9.39.1",
    "globals": "16.5.0",
    "prettier": "2.8.8",
    "prisma": "5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "8.46.2"
  }
}
