# Public values embedded in the mobile app. Never put server secrets in this file.
# Use the deployed Render service URL in deployed builds.
API_URL=https://YOUR-RENDER-SERVICE.onrender.com/api
MAPTILER_API_KEY=your_public_maptiler_key

# For local development, override API_URL in mobile/.env. For example:
# API_URL=http://localhost:5000/api
# A physical Android device also needs `adb reverse tcp:5000 tcp:5000`, or a LAN-reachable URL.
