# Copy this to local.properties (already gitignored) and fill in real values.
# local.properties is never committed -- see android/app/build.gradle for how
# MAPS_API_KEY is read.

sdk.dir=/path/to/your/Android/Sdk

# Google Maps API key, used by react-native-maps (Android only -- there's no
# Apple Maps on Android, so this is required for the Map tab to render tiles).
# Get one from https://console.cloud.google.com/ -> APIs & Services ->
# Credentials -> Create Credentials -> API key, then enable the "Maps SDK for
# Android" API, and restrict the key to your app's package name
# (com.ridezz.mobile) + debug/release signing certificate SHA-1 fingerprints.
# Without this, the app still builds and runs, but the Map tab shows a blank/
# grey map instead of real tiles.
MAPS_API_KEY=
