<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 6-11 (API 23-30) auto-backup rules. allowBackup="false" already disables backup; this
  file keeps that explicit: nothing is backed up, including the link-auth identity metadata
  (shared preference file rideaze_link_identity_v1).
-->
<full-backup-content>
  <exclude domain="root" path="." />
  <exclude domain="file" path="." />
  <exclude domain="database" path="." />
  <exclude domain="sharedpref" path="." />
  <exclude domain="external" path="." />
</full-backup-content>
