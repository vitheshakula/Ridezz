+# Without this, nothing in this link explicitly names the C++ runtime, and the final link fails
+# with "undefined symbol: operator new/delete, __cxa_throw, std::out_of_range, ..." -- every
+# symbol this file's use of std::string/exceptions/RTTI needs. ANDROID_STL is already c++_shared
+# (confirmed in CMakeCache.txt); target_compile_reactnative_options() above does not end up
+# linking it for this target regardless, so it's named explicitly here.
+target_link_libraries(
+  react_codegen_rnsvg
+  c++_shared
+)
