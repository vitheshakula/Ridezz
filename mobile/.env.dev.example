# Local development: your laptop's server (e.g. via ngrok or adb reverse).
# Copy to .env.dev and fill in. Read by the "dev" Android flavor (see android/app/build.gradle).
# Values are baked in at build time: rebuild the app after changing them.

# Backend base URL, ending in /api.
API_URL=http://localhost:5000/api
# MapTiler key for map tiles and destination search (https://cloud.maptiler.com/account/keys).
MAPTILER_API_KEY=YOUR_MAPTILER_API_KEY
